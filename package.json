  "scripts": {
    "build": "node -e \"const {execSync}=require('child_process'),fs=require('fs');const py=fs.existsSync('.venv/Scripts/python.exe')?'\\\".venv/Scripts/python.exe\\\"':fs.existsSync('.venv/bin/python')?'.venv/bin/python':'python';execSync(py+' manage.py check && '+py+' manage.py collectstatic --noinput',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@vercel/speed-insights": "^2.1.0"
  }
}
