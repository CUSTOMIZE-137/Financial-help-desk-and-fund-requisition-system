DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database configuration (SQLite by default; PostgreSQL via DATABASE_URL or DB_* variables):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/financial_helpdesk
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=financial_helpdesk
# DB_USER=postgres
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_SSLMODE=prefer

# Caching (LocMemCache by default; Redis when REDIS_URL is set):
# REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=300

# File storage ("local", "shared_fs", or "s3"):
STORAGE_BACKEND=local
# MEDIA_ROOT=/var/lib/financedesk/media
# AWS_STORAGE_BUCKET_NAME=financedesk-evidence
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_QUERYSTRING_AUTH=True
# STORAGE_USE_SIGNED_REDIRECT=False

# Background task processing ("eager", "thread", or "db_queue"):
BACKGROUND_TASK_MODE=eager
WORKFLOW_EMAIL_NOTIFICATIONS=False

# Site URL and SMTP email settings for sending staff enrollment invitations:
SITE_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=noreply@financedesk.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True

# Microsoft Entra ID (OIDC Single Sign-On) and Role Synchronization:
MICROSOFT_AUTH_ENABLED=False
MICROSOFT_ALLOW_LOCAL_LOGIN=True
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret
# MICROSOFT_REDIRECT_URI=https://financedesk.example.org/auth/microsoft/callback/
# MICROSOFT_POST_LOGOUT_REDIRECT_URI=https://financedesk.example.org/login/
# MICROSOFT_ALLOWED_GROUPS=
# MICROSOFT_AUTO_PROVISION_USERS=False
# MICROSOFT_LINK_EXISTING_BY_EMAIL=True
# MICROSOFT_ROLE_MAPPING={"group-uuid-finance":"FINANCE","group-uuid-supervisor":{"role":"SUPERVISOR","department":"Programs"}}
# MICROSOFT_UNMAPPED_USER_POLICY=deny
# MICROSOFT_STRICT_ROLE_SYNC=True
# MICROSOFT_GRAPH_GROUP_FALLBACK=False
# MICROSOFT_ALLOWED_TENANTS=
# MICROSOFT_DEPARTMENT_CLAIM=department
# MICROSOFT_OIDC_SCOPES=openid,profile,email
# MICROSOFT_HTTP_TIMEOUT=10
# MICROSOFT_TOKEN_CLOCK_SKEW_SECONDS=60

# Microsoft Teams Integration & Optional Notifications:
MICROSOFT_TEAMS_ENABLED=False
# MICROSOFT_TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_NOTIFICATIONS_ENABLED=False
# MICROSOFT_TEAMS_WEBHOOK_URL=https://example.webhook.office.com/webhookb2/...

# Failed-login throttling:
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
